# Chave de API do football-data.org (tier gratuito)
# Crie uma conta em https://www.football-data.org e copie a chave
FOOTBALL_DATA_API_KEY=sua_chave_aqui

# Firebase Admin SDK — Credenciais para desenvolvimento local
# Em produção (Firebase App Hosting / Cloud Run) as credenciais são automáticas.
#
# Para desenvolvimento local:
# 1. Acesse: Firebase Console → Configurações do projeto → Contas de serviço
# 2. Clique em "Gerar nova chave privada" → baixe o JSON
# 3. Salve o arquivo na raiz do projeto (ex: firebase-service-account.json)
#    (já está no .gitignore — nunca commite esse arquivo)
# 4. Descomente a linha abaixo:
# GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
